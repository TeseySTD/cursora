{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SessionRequest": {
        "additionalProperties": false,
        "description": "What the widget sends when a page with it loads.",
        "properties": {
          "site_key": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Site Key",
            "type": "string"
          }
        },
        "required": [
          "site_key"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "SessionResponse": {
        "description": "The visitor's current session. The id itself is only in the HttpOnly cookie.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SessionState"
          }
        },
        "required": [
          "state",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionState": {
        "enum": [
          "new",
          "challenge_required",
          "verified",
          "blocked"
        ],
        "title": "SessionState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Cursora API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness probe: the process is up. Does not touch the database.",
        "operationId": "system_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/health/db": {
      "get": {
        "description": "Readiness of the database: runs ``SELECT 1``.",
        "operationId": "system_health_db",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health Db",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/gate/check": {
      "get": {
        "description": "Nginx ``auth_request`` target for protected routes.\n\nNginx treats 2xx as \"let the request through\" and 401/403 as \"deny\".\nThis stub always allows.\n\nTODO(team): decide the response codes (and any headers) for the\n``challenge_required`` and ``blocked`` outcomes, and how Nginx maps them\n(error_page / redirect to the challenge). Until then: always 204.",
        "operationId": "gate_check",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Check",
        "tags": [
          "gate"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "description": "Restore the visitor's session on the site from the cookie, or create a new one.\n\nCalled by the widget when a page with it loads, with the site key from its script tag.\n\n- 200: the cookie holds a live session of this site. It is reused as is, state included.\n- 201: no cookie, or its session is unknown, expired or of another site. A new session in\n  state ``new`` is created and its id is set in an HttpOnly cookie that expires with it.\n- 404: no site has this site key.",
        "operationId": "sessions_ensure_session",
        "parameters": [
          {
            "in": "cookie",
            "name": "cursora_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursora Session"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "The live session from the cookie was reused."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "A new session was created and set in the cookie."
          },
          "404": {
            "description": "No site has this site key."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ensure Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/signals": {
      "post": {
        "description": "Store a batch of behavioural signals for the visitor's session.\n\nThe widget sends batches while the visitor is on the page; the browser attaches the\nsession cookie. Batches that are too large or too frequent are counted on the session as a\nrequest signal for the Risk Engine.",
        "operationId": "sessions_ingest_signals",
        "parameters": [
          {
            "in": "cookie",
            "name": "cursora_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursora Session"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "One batch of behavioural signals from the widget.\n\nA batch may have no signals: it still carries the time on page (CAPTHCA-17 AC5).",
                "properties": {
                  "signals": {
                    "items": {
                      "discriminator": {
                        "propertyName": "type"
                      },
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "description": "A sampled pointer (cursor or touch) position.",
                          "properties": {
                            "pointer": {
                              "enum": [
                                "mouse",
                                "touch",
                                "pen",
                                ""
                              ],
                              "type": "string"
                            },
                            "t": {
                              "minimum": 0,
                              "type": "number"
                            },
                            "type": {
                              "const": "move",
                              "title": "Type",
                              "type": "string"
                            },
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "t",
                            "type",
                            "x",
                            "y",
                            "pointer"
                          ],
                          "title": "MoveSignal",
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "button": {
                              "maximum": 31,
                              "minimum": 0,
                              "title": "Button",
                              "type": "integer"
                            },
                            "pointer": {
                              "enum": [
                                "mouse",
                                "touch",
                                "pen",
                                ""
                              ],
                              "type": "string"
                            },
                            "t": {
                              "minimum": 0,
                              "type": "number"
                            },
                            "type": {
                              "const": "click",
                              "title": "Type",
                              "type": "string"
                            },
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "t",
                            "type",
                            "x",
                            "y",
                            "button",
                            "pointer"
                          ],
                          "title": "ClickSignal",
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "Coarse browser parameters, recorded once per page.\n\nDeliberately not a fingerprint: language, timezone, screen size and other high-entropy\nattributes are left out until fingerprints are collected as HMAC hashes (BR-32).",
                          "properties": {
                            "cookieEnabled": {
                              "title": "Cookieenabled",
                              "type": "boolean"
                            },
                            "devicePixelRatio": {
                              "exclusiveMinimum": 0,
                              "title": "Devicepixelratio",
                              "type": "number"
                            },
                            "maxTouchPoints": {
                              "minimum": 0,
                              "title": "Maxtouchpoints",
                              "type": "integer"
                            },
                            "t": {
                              "minimum": 0,
                              "type": "number"
                            },
                            "type": {
                              "const": "env",
                              "title": "Type",
                              "type": "string"
                            },
                            "viewport": {
                              "additionalProperties": false,
                              "properties": {
                                "height": {
                                  "minimum": 0,
                                  "title": "Height",
                                  "type": "integer"
                                },
                                "width": {
                                  "minimum": 0,
                                  "title": "Width",
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "width",
                                "height"
                              ],
                              "title": "Viewport",
                              "type": "object"
                            },
                            "webdriver": {
                              "title": "Webdriver",
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "t",
                            "type",
                            "viewport",
                            "devicePixelRatio",
                            "maxTouchPoints",
                            "webdriver",
                            "cookieEnabled"
                          ],
                          "title": "EnvironmentSignal",
                          "type": "object"
                        }
                      ]
                    },
                    "title": "Signals",
                    "type": "array"
                  },
                  "t": {
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "t",
                  "signals"
                ],
                "title": "SignalBatchIn",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No session cookie, or its session is unknown or expired. The batch is not stored; open a new session instead of retrying it."
          },
          "413": {
            "description": "The batch is larger or has more signals than allowed. Not stored."
          },
          "422": {
            "description": "The batch is not valid JSON of the expected shape. Not stored."
          },
          "429": {
            "description": "The session sent too many batches. Not stored; see Retry-After."
          }
        },
        "summary": "Ingest Signals",
        "tags": [
          "sessions"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes.",
      "name": "system"
    },
    {
      "description": "Sites, site keys and per-site settings.",
      "name": "tenant"
    },
    {
      "description": "Widget sessions and collected signals.",
      "name": "sessions"
    },
    {
      "description": "Risk Engine: features -> score -> decision.",
      "name": "risk"
    },
    {
      "description": "Nginx auth_request endpoint for protected routes.",
      "name": "gate"
    },
    {
      "description": "Aggregate statistics for the admin panel.",
      "name": "insights"
    }
  ]
}
