{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SessionResponse": {
        "description": "The visitor's current session. The id itself is only in the HttpOnly cookie.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SessionState"
          }
        },
        "required": [
          "state",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionState": {
        "enum": [
          "new",
          "challenge_required",
          "verified",
          "blocked"
        ],
        "title": "SessionState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Cursora API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness probe: the process is up. Does not touch the database.",
        "operationId": "system_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/health/db": {
      "get": {
        "description": "Readiness of the database: runs ``SELECT 1``.",
        "operationId": "system_health_db",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health Db",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/gate/check": {
      "get": {
        "description": "Nginx ``auth_request`` target for protected routes.\n\nNginx treats 2xx as \"let the request through\" and 401/403 as \"deny\".\nThis stub always allows.\n\nTODO(team): decide the response codes (and any headers) for the\n``challenge_required`` and ``blocked`` outcomes, and how Nginx maps them\n(error_page / redirect to the challenge). Until then: always 204.",
        "operationId": "gate_check",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Check",
        "tags": [
          "gate"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "description": "Restore the visitor's session from the cookie, or create a new one.\n\nCalled by the widget when a page with it loads.\n\n- 200: the cookie holds a live session. It is reused as is, state included.\n- 201: no cookie, or its session is unknown or expired. A new session in state ``new``\n  is created and its id is set in an HttpOnly cookie that expires with the session.",
        "operationId": "sessions_ensure_session",
        "parameters": [
          {
            "in": "cookie",
            "name": "cursora_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursora Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "The live session from the cookie was reused."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "A new session was created and set in the cookie."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ensure Session",
        "tags": [
          "sessions"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes.",
      "name": "system"
    },
    {
      "description": "Sites, site keys and per-site settings.",
      "name": "tenant"
    },
    {
      "description": "Widget sessions and collected signals.",
      "name": "sessions"
    },
    {
      "description": "Risk Engine: features -> score -> decision.",
      "name": "risk"
    },
    {
      "description": "Nginx auth_request endpoint for protected routes.",
      "name": "gate"
    },
    {
      "description": "Aggregate statistics for the admin panel.",
      "name": "insights"
    }
  ]
}
