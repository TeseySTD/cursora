# Copy to .env (git-ignored) and uncomment what you need to change.
# Every value below is the built-in default, so an empty .env works.
# .env is read by: the API (pydantic-settings, when run from the repo root),
# Docker Compose (variable interpolation via scripts/compose.mjs) and Vite (admin).

# --- API (apps/api, prefix CURSORA_) -----------------------------------------
# CURSORA_ENV=dev                 # dev | test | prod (Docker stack defaults to prod)
# CURSORA_LOG_LEVEL=INFO
# Local runs (pnpm dev:api, db:migrate, tests). Docker builds its own URL from POSTGRES_*.
# Use 127.0.0.1, not localhost: on Windows "localhost" may resolve to ::1 and hang.
# CURSORA_DATABASE_URL=postgresql+asyncpg://cursora:cursora@127.0.0.1:5432/cursora
# CURSORA_DB_ECHO=false           # log every SQL statement
# CURSORA_DB_CONNECT_TIMEOUT_S=5

# --- Postgres (Docker Compose) -----------------------------------------------
# POSTGRES_USER=cursora
# POSTGRES_PASSWORD=cursora
# POSTGRES_DB=cursora
# POSTGRES_PORT=5432              # host port, dev compose only (pnpm db:up)

# --- Nginx host ports (Docker Compose) ---------------------------------------
# CURSORA_HTTP_PORT=8080          # admin at /, /api/, /widget/widget.js
# ORIGIN_HTTP_PORT=8081           # sample customer site; /protected/ goes through the gate

# --- Admin (Vite, build-time) ------------------------------------------------
# VITE_API_BASE_URL=/api          # "/api" uses the Vite dev proxy or Nginx

# --- Tests -------------------------------------------------------------------
# REQUIRE_DB=1                    # fail (not skip) integration tests when Postgres is down; set in CI
