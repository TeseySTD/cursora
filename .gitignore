# Dependencies
node_modules/
.venv/

# Build output
dist/
build/
*.tsbuildinfo

# Python caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ML artefacts
ml/data/*
!ml/data/.gitkeep
ml/models/*
!ml/models/.gitkeep
.ipynb_checkpoints/

# Env
.env
.env.*
!.env.example

# Tooling / OS
.vite/
coverage/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Generated from packages/api-client/openapi.json on install (`prepare`)
packages/api-client/src/generated/

# OpenSpec: only the shared configuration is committed; specs, changes and drafts are per-user.
# Ignore the directory's contents (not the directory) so the config can be re-included.
/openspec/*
!/openspec/config.yaml
!/openspec/schemas/
